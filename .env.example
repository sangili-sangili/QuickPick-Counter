# ========================================================
# QuickPick Counter — Environment Configuration Template
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickpick?schema=public"

# Authentication Security (JWT)
JWT_SECRET="quickpick-super-secret-jwt-key-2026"

# Payment Gateway HMAC-SHA256 Webhook Secret
WEBHOOK_SECRET="quickpick_shared_webhook_secret_2026"

# Frontend API Base URL (Vite)
VITE_API_URL="http://localhost:3000/api"
